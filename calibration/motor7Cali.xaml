<UserControl x:Class="WpfRobot.calibration.motor7Cali"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfRobot.calibration"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1250"
             Background="White">
     <UserControl.Resources>

        <!-- 圆角按钮 -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4,8,4"/>
        </Style>

        <Style x:Key="ValueBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>


    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="165"/>-->
        </Grid.RowDefinitions>


        <!-- 顶部标题栏 -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                BorderBrush="#D8E0EA"
                BorderThickness="1"
                Padding="16,8">

            <DockPanel LastChildFill="True">

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">

                    <TextBlock Text="第七电机零位标定"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="读取第七电机编码器角度，设置当前位置为机械零点，并保存零点偏移量"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,3,0,0"/>
                </StackPanel>


                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="当前状态："
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               FontSize="13"
                               Margin="0,0,4,0"/>

                    <TextBlock x:Name="TxtConnectStatus"
                               Text="未连接"
                               VerticalAlignment="Center"
                               Foreground="#64748B"
                               FontSize="15"
                               FontWeight="Bold"
                               Margin="0,0,14,0"/>

                    <Button x:Name="BtnConnectMotor7"
                            Content="连接电机"
                            Width="92"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnConnectMotor7_Click"/>

                    <Button x:Name="BtnDisconnectMotor7"
                            Content="断开连接"
                            Width="92"
                            Style="{StaticResource RoundButtonStyle}"
                            Click="BtnDisconnectMotor7_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>


        <!-- 中间主体区域 -->
        <Grid Grid.Row="1"
              Margin="0,10,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.1*"/>
            </Grid.ColumnDefinitions>


            <!-- 左侧：实时状态 -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,10">

                        <TextBlock Text="第七电机实时状态"
                                   Style="{StaticResource CardTitleStyle}"
                                   DockPanel.Dock="Left"/>

                        <TextBlock x:Name="TxtMonitorStatus"
                                   Text="未监测"
                                   DockPanel.Dock="Right"
                                   Foreground="#64748B"
                                   FontSize="13"/>
                    </DockPanel>


                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="编码器角度"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="电机驱动器直接读取到的原始角度，单位：deg"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,8"/>

                                    <TextBox x:Name="TxtEncoderAngle"
                                             Text="0.000"
                                             IsReadOnly="True"
                                             Style="{StaticResource ValueBoxStyle}"/>

                                    <TextBlock Text="zero_offset"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,14,0,8"/>

                                    <TextBlock Text="零点偏移量。设置当前位置为零点后，zero_offset = 当前编码器角度"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,8"/>

                                    <TextBox x:Name="TxtZeroOffset"
                                             Text="0.000"
                                             IsReadOnly="True"
                                             Style="{StaticResource ValueBoxStyle}"/>

                                    <TextBlock Text="软件角度 q7"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,14,0,8"/>

                                    <TextBlock Text="q7 = encoder_angle - zero_offset"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,8"/>

                                    <TextBox x:Name="TxtSoftwareAngle"
                                             Text="0.000"
                                             IsReadOnly="True"
                                             Style="{StaticResource ValueBoxStyle}"/>

                                </StackPanel>
                            </Border>


                            <Border Background="#EFF6FF"
                                    BorderBrush="#93C5FD"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">

                                <StackPanel>

                                    <TextBlock Text="电机状态"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#1E40AF"
                                               Margin="0,0,0,8"/>

                                    <TextBox x:Name="TxtMotorState"
                                             Text="Motor State: --&#x0a;Servo: --&#x0a;Alarm: --&#x0a;Limit: --"
                                             Background="White"
                                             BorderBrush="#CBD5E1"
                                             BorderThickness="1"
                                             FontFamily="Consolas"
                                             FontSize="13"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             MinHeight="110"
                                             VerticalScrollBarVisibility="Auto"/>

                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>


                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <Button x:Name="BtnReadMotor7"
                                Content="读取一次"
                                Width="86"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnReadMotor7_Click"/>

                        <Button x:Name="BtnStartMonitor"
                                Content="开始监测"
                                Width="86"
                                Style="{StaticResource RoundButtonStyle}"
                                Click="BtnStartMonitor_Click"/>

                        <Button x:Name="BtnStopMonitor"
                                Content="停止监测"
                                Width="86"
                                Style="{StaticResource RoundButtonStyle}"
                                Click="BtnStopMonitor_Click"/>

                    </StackPanel>

                </Grid>
            </Border>


            <!-- 中间：零点标定 -->
            <Border Grid.Column="1"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="零点标定操作"
                               Style="{StaticResource CardTitleStyle}"/>


                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto">

                        <StackPanel>

                            <Border Background="#FFF7ED"
                                    BorderBrush="#FDBA74"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                <StackPanel>
                                    <TextBlock Text="标定步骤"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#9A3412"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="1. 连接第七电机。&#x0a;2. 点动电机，使器械 / 第七轴到达机械零位。&#x0a;3. 点击“设置当前位置为零点”。&#x0a;4. 检查软件角度 q7 是否变为 0。&#x0a;5. 保存 zero_offset。"
                                               FontSize="13"
                                               Foreground="#7C2D12"
                                               TextWrapping="Wrap"
                                               LineHeight="22"/>
                                </StackPanel>
                            </Border>


                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12"
                                    Margin="0,0,0,10">

                                <StackPanel>

                                    <TextBlock Text="设置软件零点"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Text="将当前编码器角度作为零点偏移量：zero_offset = encoder_angle"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,10"/>

                                    <Button x:Name="BtnSetCurrentZero"
                                            Content="设置当前位置为零点"
                                            Height="38"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Click="BtnSetCurrentZero_Click"/>
                                </StackPanel>
                            </Border>


                            <Border Background="#F8FAFC"
                                    BorderBrush="#E2E8F0"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="12">

                                <Grid>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Text="手动输入 zero_offset"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="#0F172A"
                                               Margin="0,0,0,8"/>

                                    <TextBlock Grid.Row="1"
                                               Text="如果你已经有历史零点偏移量，也可以手动输入并应用。"
                                               Style="{StaticResource HintTextStyle}"
                                               Margin="0,0,0,8"/>

                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBox x:Name="TxtManualOffset"
                                                 Grid.Column="0"
                                                 Text="0.000"
                                                 Style="{StaticResource ValueBoxStyle}"
                                                 Margin="0,4,8,4"/>

                                        <Button x:Name="BtnApplyManualOffset"
                                                Grid.Column="1"
                                                Content="应用"
                                                Style="{StaticResource RoundButtonStyle}"
                                                Click="BtnApplyManualOffset_Click"/>
                                    </Grid>

                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>


                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">
                        
                        <Button x:Name="BtnClearEncoderHardwareZero"
                                Content="编码器清零"
                                Width="90"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="BtnClearEncoderHardwareZero_Click"/>
                        
                        <Button x:Name="BtnLoadZero"
                                Content="加载零点"
                                Width="90"
                                Style="{StaticResource RoundButtonStyle}"
                                Click="BtnLoadZero_Click"/>

                        <Button x:Name="BtnSaveZero"
                                Content="保存零点"
                                Width="90"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnSaveZero_Click"/>

                    </StackPanel>

                </Grid>
            </Border>


            <!-- 右侧：点动验证与记录 -->
            <Border Grid.Column="2"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    Padding="12">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>


                    <TextBlock Grid.Row="0"
                               Text="点动验证与记录"
                               Style="{StaticResource CardTitleStyle}"/>


                    <Border Grid.Row="1"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="12"
                            Margin="0,0,0,10">

                        <StackPanel>

                            <TextBlock Text="点动测试"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="#0F172A"
                                       Margin="0,0,0,8"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="步长 deg："
                                           Style="{StaticResource LabelTextStyle}"/>

                                <TextBox x:Name="TxtJogStep"
                                         Grid.Column="1"
                                         Text="1.000"
                                         Style="{StaticResource ValueBoxStyle}"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,8,0,0">

                                <Button x:Name="BtnJogPlus"
                                        Content="+ 点动"
                                        Width="90"
                                        Style="{StaticResource RoundButtonStyle}"
                                        Click="BtnJogPlus_Click"/>

                                <Button x:Name="BtnJogMinus"
                                        Content="- 点动"
                                        Width="90"
                                        Style="{StaticResource RoundButtonStyle}"
                                        Click="BtnJogMinus_Click"/>

                                <Button x:Name="BtnMoveToZero"
                                        Content="回零"
                                        Width="90"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnMoveToZero_Click"/>

                            </StackPanel>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="96"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="目标 q7："
                                           Style="{StaticResource LabelTextStyle}"/>

                                <TextBox x:Name="TxtTargetAngle"
                                         Grid.Column="1"
                                         Text="0.000"
                                         Style="{StaticResource ValueBoxStyle}"
                                         Margin="0,4,8,4"/>

                                <Button x:Name="BtnMoveToTarget"
                                        Grid.Column="2"
                                        Content="运动到目标"
                                        Style="{StaticResource RoundButtonStyle}"
                                        Click="BtnMoveToTarget_Click"/>
                            </Grid>

                        </StackPanel>
                    </Border>


                    <DataGrid x:Name="ZeroRecordDataGrid"
                              Grid.Row="2"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              Background="#F8FAFC"
                              BorderBrush="#E2E8F0"
                              BorderThickness="1">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号"
                                                Binding="{Binding Index}"
                                                Width="50"/>

                            <DataGridTextColumn Header="时间"
                                                Binding="{Binding Time}"
                                                Width="90"/>

                            <DataGridTextColumn Header="编码器角"
                                                Binding="{Binding EncoderDeg}"
                                                Width="90"/>

                            <DataGridTextColumn Header="ZeroOffset"
                                                Binding="{Binding ZeroOffsetDeg}"
                                                Width="95"/>

                            <DataGridTextColumn Header="备注"
                                                Binding="{Binding Note}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>


                    <StackPanel Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">

                        <Button x:Name="BtnAddRecord"
                                Content="记录当前"
                                Width="90"
                                Style="{StaticResource RoundButtonStyle}"
                                Click="BtnAddRecord_Click"/>

                        <Button x:Name="BtnClearRecords"
                                Content="清空记录"
                                Width="90"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="BtnClearRecords_Click"/>

                    </StackPanel>

                </Grid>
            </Border>

        </Grid>


        <!-- 底部日志 --><!--
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                BorderBrush="#D8E0EA"
                BorderThickness="1"
                Padding="12">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0"
                           Margin="0,0,0,6">

                    <TextBlock Text="第七电机标定日志"
                               Foreground="#0F172A"
                               FontSize="15"
                               FontWeight="Bold"
                               DockPanel.Dock="Left"/>

                    <Button x:Name="BtnClearLog"
                            Content="清空日志"
                            DockPanel.Dock="Right"
                            Width="82"
                            Height="24"
                            FontSize="12"
                            Style="{StaticResource RoundButtonStyle}"
                            Click="BtnClearLog_Click"/>
                </DockPanel>


                <Border Grid.Row="1"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="8">

                    <TextBox x:Name="TxtLog"
                             Background="Transparent"
                             Foreground="#D1D5DB"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="13"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             IsReadOnly="True"/>
                </Border>

            </Grid>
        </Border>-->

    </Grid>
</UserControl>