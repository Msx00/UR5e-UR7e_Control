<UserControl x:Class="WpfRobot.calibration.endoCali"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:WpfRobot.calibration"
             mc:Ignorable="d"
             d:DesignHeight="820"
             d:DesignWidth="1250"
             Background="White">

    <UserControl.Resources>

        <!-- 圆角按钮 -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#DBEAFE"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#2563EB"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="BorderBrush" Value="#2563EB"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1D4ED8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1D4ED8"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#1E40AF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#1E40AF"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter TargetName="border" Property="Background" Value="#94A3B8"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 危险按钮 -->
        <Style x:Key="DangerButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource RoundButtonStyle}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#DC2626"/>
            <Setter Property="BorderBrush" Value="#DC2626"/>
        </Style>

        <!-- 卡片标题 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- 提示文字 -->
        <Style x:Key="HintTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

    </UserControl.Resources>


    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
            <!--<RowDefinition Height="140"/>-->
        </Grid.RowDefinitions>


        <!-- 顶部标题栏 -->
        <Border Grid.Row="0"
                Background="White"
                CornerRadius="14"
                BorderBrush="#D8E0EA"
                BorderThickness="1"
                Padding="16,8">

            <DockPanel LastChildFill="True">

                <StackPanel Orientation="Vertical"
                            VerticalAlignment="Center">

                    <TextBlock Text="单目内窥镜内参标定"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="#0F172A"/>

                    <TextBlock Text="采集多张标定板图像，计算相机内参和畸变参数"
                               FontSize="13"
                               Foreground="#64748B"
                               Margin="0,3,0,0"/>
                </StackPanel>


                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">

                    <TextBlock Text="相机："
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               FontSize="13"
                               Margin="0,0,4,0"/>

                    <ComboBox x:Name="Cam_comboBox"
                              Width="210"
                              Height="32"
                              FontSize="13"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"
                              ToolTip="选择电脑上检测到的相机设备"/>

                    <Button x:Name="BtnRefreshCamera"
                            Content="刷新"
                            Width="90"
                            Style="{StaticResource RoundButtonStyle}"
                            Click="BtnRefreshCamera_Click"/>

                    <TextBlock Text="采集数量："
                               VerticalAlignment="Center"
                               Foreground="#475569"
                               FontSize="13"
                               Margin="10,0,4,0"/>

                    <TextBlock x:Name="TxtImageCount"
                               Text="0"
                               VerticalAlignment="Center"
                               Foreground="#2563EB"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,14,0"/>

                    <Button x:Name="BtnOpenCamera"
                            Content="打开相机"
                            Width="92"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnOpenCamera_Click"/>

                    <Button x:Name="BtnStopCamera"
                            Content="停止预览"
                            Width="92"
                            Style="{StaticResource RoundButtonStyle}"
                            Click="BtnStopCamera_Click"/>

                </StackPanel>

            </DockPanel>
        </Border>


        <!-- 中间主体区域 -->
        <Grid Grid.Row="1"
              Margin="0,10,0,10">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*"/>
                <ColumnDefinition Width="0.95*"/>
            </Grid.ColumnDefinitions>


            <!-- 左侧：实时画面 -->
            <Border Grid.Column="0"
                    Background="White"
                    CornerRadius="14"
                    BorderBrush="#D8E0EA"
                    BorderThickness="1"
                    Padding="12"
                    Margin="0,0,10,0">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0"
                               Margin="0,0,0,10">

                        <TextBlock Text="实时内窥镜画面"
                                   Style="{StaticResource CardTitleStyle}"
                                   DockPanel.Dock="Left"/>

                        <TextBlock x:Name="TxtCameraStatus"
                                   Text="相机未打开"
                                   DockPanel.Dock="Right"
                                   FontSize="13"
                                   Foreground="#64748B"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>


                    <Border Grid.Row="1"
                            Background="#020617"
                            CornerRadius="12"
                            BorderBrush="#1E293B"
                            BorderThickness="1">

                        <Grid>

                            <Image x:Name="ImgLive"
                                   Stretch="Uniform"
                                   SnapsToDevicePixels="True"/>

                            <TextBlock x:Name="TxtLivePlaceholder"
                                       Text="等待内窥镜画面..."
                                       Foreground="#94A3B8"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                        </Grid>
                    </Border>


                    <StackPanel Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0">

                        <Button x:Name="BtnCapture"
                                Content="拍照采集"
                                Width="110"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="BtnCapture_Click"/>

                        <Button x:Name="BtnDetectBoard"
                                Content="检测标定板"
                                Width="110"
                                Style="{StaticResource RoundButtonStyle}"
                                Click="BtnDetectBoard_Click"/>

                    </StackPanel>

                </Grid>
            </Border>


            <!-- 右侧：静态图像与列表 -->
            <Grid Grid.Column="1">

                <Grid.RowDefinitions>
                    <RowDefinition Height="1.15*"/>
                    <RowDefinition Height="0.85*"/>
                </Grid.RowDefinitions>


                <!-- 静态预览 -->
                <Border Grid.Row="0"
                        Background="White"
                        CornerRadius="14"
                        BorderBrush="#D8E0EA"
                        BorderThickness="1"
                        Padding="12"
                        Margin="0,0,0,10">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   Margin="0,0,0,10">

                            <TextBlock Text="静态采集画面"
                                       Style="{StaticResource CardTitleStyle}"
                                       DockPanel.Dock="Left"/>

                            <TextBlock x:Name="TxtSelectedImageIndex"
                                       Text="未选择"
                                       DockPanel.Dock="Right"
                                       FontSize="13"
                                       Foreground="#64748B"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>


                        <Border Grid.Row="1"
                                Background="#020617"
                                CornerRadius="12"
                                BorderBrush="#1E293B"
                                BorderThickness="1">

                            <Grid>

                                <Image x:Name="ImgCaptured"
                                       Stretch="Uniform"
                                       SnapsToDevicePixels="True"/>

                                <TextBlock x:Name="TxtCapturedPlaceholder"
                                           Text="拍照后图像将在这里显示"
                                           Foreground="#94A3B8"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                            </Grid>
                        </Border>


                        <TextBlock x:Name="TxtCapturedInfo"
                                   Grid.Row="2"
                                   Text="当前未采集图像。建议采集 10～20 张不同角度、不同位置的无拖影标定板图像。"
                                   Foreground="#64748B"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                    </Grid>
                </Border>


                <!-- 已采集图像列表 -->
                <Border Grid.Row="1"
                        Background="White"
                        CornerRadius="14"
                        BorderBrush="#D8E0EA"
                        BorderThickness="1"
                        Padding="12">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="已采集图像列表"
                                   Style="{StaticResource CardTitleStyle}"/>

                        <ListBox x:Name="CapturedImagesList"
                                 Grid.Row="1"
                                 BorderBrush="#E2E8F0"
                                 BorderThickness="1"
                                 Background="#F8FAFC"
                                 SelectionChanged="CapturedImagesList_SelectionChanged"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10">

                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0"
                                                Width="70"
                                                Height="50"
                                                Background="#020617"
                                                CornerRadius="6"
                                                ClipToBounds="True">

                                            <Image Source="{Binding ImageSource}"
                                                   Stretch="Uniform"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Margin="8,0,0,0">

                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0F172A"/>

                                            <TextBlock Text="{Binding CaptureTime}"
                                                       FontSize="12"
                                                       Foreground="#64748B"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>


                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                            <Button x:Name="BtnPreviousImage"
                                    Content="上一张"
                                    Width="80"
                                    Style="{StaticResource RoundButtonStyle}"
                                    Click="BtnPreviousImage_Click"/>

                            <Button x:Name="BtnNextImage"
                                    Content="下一张"
                                    Width="80"
                                    Style="{StaticResource RoundButtonStyle}"
                                    Click="BtnNextImage_Click"/>

                            <Button x:Name="BtnDeleteImage"
                                    Content="删除"
                                    Width="80"
                                    Style="{StaticResource RoundButtonStyle}"
                                    Click="BtnDeleteImage_Click"/>

                            <Button x:Name="BtnClearImages"
                                    Content="清空"
                                    Width="80"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Click="BtnClearImages_Click"/>
                            
                            <Button x:Name="BtnCaliImages"
                                    Content="标定"
                                    Width="80"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnRunCalibration_Click"/>

                            
                        </StackPanel>

                    </Grid>
                </Border>

            </Grid>
        </Grid>


        <!-- 底部：标定控制与日志 --><!--
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="14"
                BorderBrush="#D8E0EA"
                BorderThickness="1"
                Padding="12">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>


                --><!-- 标定参数输出 --><!--
                <Border Grid.Column="0"
                        Background="#F8FAFC"
                        BorderBrush="#E2E8F0"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12"
                        Margin="0,0,10,0">

                    <StackPanel>

                        <TextBlock Text="标定输出"
                                   FontSize="15"
                                   FontWeight="Bold"
                                   Foreground="#0F172A"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtCalibrationResult"
                                   Text="尚未执行标定。输出将包括 fx, fy, cx, cy, k1, k2, p1, p2, k3。"
                                   FontSize="13"
                                   Foreground="#475569"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                            <Button x:Name="BtnRunCalibration"
                                    Content="执行标定"
                                    Width="96"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnRunCalibration_Click"/>

                            <Button x:Name="BtnSaveCalibration"
                                    Content="保存结果"
                                    Width="96"
                                    Style="{StaticResource RoundButtonStyle}"
                                    Click="BtnSaveCalibration_Click"/>

                        </StackPanel>

                    </StackPanel>
                </Border>


                --><!-- 日志 --><!--
                <Border Grid.Column="1"
                        Background="#0F172A"
                        BorderBrush="#1E293B"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="8">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0"
                                   Margin="0,0,0,6">

                            <TextBlock Text="标定日志"
                                       Foreground="#E5E7EB"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Left"/>

                            <Button x:Name="BtnClearLog"
                                    Content="清空日志"
                                    DockPanel.Dock="Right"
                                    Width="82"
                                    Height="24"
                                    FontSize="12"
                                    Style="{StaticResource RoundButtonStyle}"
                                    Click="BtnClearLog_Click"/>
                        </DockPanel>

                        <TextBox x:Name="TxtLog"
                                 Grid.Row="1"
                                 Background="Transparent"
                                 Foreground="#D1D5DB"
                                 BorderThickness="0"
                                 FontFamily="Consolas"
                                 FontSize="13"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 IsReadOnly="True"/>

                    </Grid>
                </Border>

            </Grid>
        </Border>-->

    </Grid>
</UserControl>