<Window x:Class="WpfRobot.robParameter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="机器人状态监测与参数设定"
        Height="900"
        Width="1600"
        MinHeight="760"
        MinWidth="1280"
        WindowStartupLocation="CenterScreen"
        Background="#000000">

    <Window.Resources>

        <!-- ===================== 基础颜色 ===================== -->
        <SolidColorBrush x:Key="BrushPrimary" Color="#2F66E9"/>
        <SolidColorBrush x:Key="BrushPrimaryDark" Color="#0B1220"/>
        <SolidColorBrush x:Key="BrushPrimaryLight" Color="#EAF1FF"/>
        <SolidColorBrush x:Key="BrushSuccess" Color="#22A447"/>
        <SolidColorBrush x:Key="BrushWarning" Color="#F59E0B"/>
        <SolidColorBrush x:Key="BrushDanger" Color="#E53935"/>
        <SolidColorBrush x:Key="BrushTextMain" Color="#0F172A"/>
        <SolidColorBrush x:Key="BrushTextSub" Color="#53627A"/>
        <SolidColorBrush x:Key="BrushBorder" Color="#D4DCE8"/>
        <SolidColorBrush x:Key="BrushCard" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BrushPageBg" Color="#000000"/>
        <SolidColorBrush x:Key="BrushSidebarBg" Color="#000000"/>

        <!-- ===================== 通用文本 ===================== -->
        <Style x:Key="TitleTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSub}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="ValueTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SmallValueTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ValueTextStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- ===================== 卡片 ===================== -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="6"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8"
                                      ShadowDepth="1"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InnerBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="#FBFCFE"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Margin" Value="3"/>
        </Style>

        <!-- ===================== TextBox ===================== -->
        <Style x:Key="ParamTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="MinWidth" Value="74"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9D3E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ReadonlyBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ParamTextBoxStyle}">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E3E8F0"/>
        </Style>

        <!-- 参数项：Label 在上，TextBox 在下，避免长文字和输入框遮挡 -->
        <Style x:Key="ParamFieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#53627A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="CompactParamTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource ParamTextBoxStyle}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- ===================== Button ===================== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushPrimary}"/>
        </Style>

        <!-- ===================== 状态点 ===================== -->
        <Style x:Key="StatusDotGreen" TargetType="Ellipse">
            <Setter Property="Width" Value="9"/>
            <Setter Property="Height" Value="9"/>
            <Setter Property="Fill" Value="{StaticResource BrushSuccess}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>

        <Style x:Key="IoDotOn" TargetType="Ellipse">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Fill" Value="{StaticResource BrushPrimary}"/>
            <Setter Property="Stroke" Value="#0A5DC5"/>
            <Setter Property="StrokeThickness" Value="1"/>
        </Style>

        <Style x:Key="IoDotOff" TargetType="Ellipse" BasedOn="{StaticResource IoDotOn}">
            <Setter Property="Fill" Value="#B8C0CC"/>
            <Setter Property="Stroke" Value="#A8B0BC"/>
        </Style>

        <!-- ===================== 顶部状态胶囊 ===================== -->
        <Style x:Key="StatusChipStyle" TargetType="Border">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="15"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Margin" Value="5,0"/>
        </Style>

        <!-- ===================== 表格单元 ===================== -->
        <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#475467"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="TableCellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextMain}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!-- =========================================================
         页面主体
         ========================================================= -->
    <Grid Background="{StaticResource BrushPageBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="58"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== 顶部标题栏 ===================== -->
        <Border Grid.Row="0"
                Grid.Column="1"
                Background="{StaticResource BrushPrimaryDark}"
                BorderBrush="#1F2937"
                BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🤖" FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Text="机器人状态监测与参数设定"
                               Style="{StaticResource TitleTextStyle}"/>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDotGreen}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtConnectionState"
                                       Text="已连接"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EllipseDashboardTopDot" Style="{StaticResource StatusDotGreen}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtDashboardState" Text="Dashboard未连接"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="EllipseRtdeTopDot" Style="{StaticResource StatusDotGreen}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtRobotCommState"
                                       Text="RTDE"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatusChipStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🌐" FontSize="13" Margin="0,0,5,0"/>
                            <Ellipse x:Name="EllipseNetworkTopDot" Style="{StaticResource StatusDotGreen}" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TxtNetworkState" Text="网络未知"
                                       Style="{StaticResource ValueTextStyle}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== 左侧导航栏 ===================== -->
        <Border Grid.Row="0"
                Grid.RowSpan="3"
                Grid.Column="0"
                Background="{StaticResource BrushSidebarBg}"
                BorderBrush="#1F2937"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="150"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="300"/>
                </Grid.RowDefinitions>

                <!-- Logo 区域 -->
                <Border Grid.Row="0"
                        Background="{StaticResource BrushPrimaryDark}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="62"
                                Height="62"
                                CornerRadius="12"
                                BorderBrush="#FFFFFF"
                                BorderThickness="3"
                                Background="#0B72E7">
                            <TextBlock Text="S"
                                       Foreground="White"
                                       FontSize="30"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- 导航 -->
                <StackPanel Grid.Row="1" Margin="8,18,8,0">
                    <Button Height="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5E7EB"
                            HorizontalContentAlignment="Left"
                            Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌂" FontSize="20" Width="32"/>
                            <TextBlock Text="总览" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="50"
                            Background="{StaticResource BrushPrimary}"
                            BorderThickness="0"
                            Foreground="White"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,6,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="10">
                                    <ContentPresenter VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▣" FontSize="18" Width="32"/>
                            <TextBlock Text="状态监测" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5E7EB"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="18" Width="32"/>
                            <TextBlock Text="参数设置" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5E7EB"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="☷" FontSize="18" Width="32"/>
                            <TextBlock Text="IO" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Height="44"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="#E5E7EB"
                            HorizontalContentAlignment="Left"
                            Padding="16,0"
                            Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" FontSize="18" Width="32"/>
                            <TextBlock Text="日志" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- 系统日志 -->
                <Border Grid.Row="2"
                        Margin="8,8,8,12"
                        Background="#0B1220"
                        BorderBrush="#1F2937"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="34"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0">
                            <TextBlock Text="系统日志"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#E5E7EB"
                                       VerticalAlignment="Center"/>
                            <Button Content="清空"
                                    Width="48"
                                    Height="24"
                                    DockPanel.Dock="Right"
                                    HorizontalAlignment="Right"
                                    FontSize="11"/>
                        </DockPanel>

                        <TextBox x:Name="TxtStatusLogBox"
                                 Grid.Row="1"
                                 Text="[18:31:45]  [INFO] Dashboard已连接&#x0a;[18:31:45]  [INFO] RTDE状态刷新正常&#x0a;[18:31:46]  [INFO] 参数已应用&#x0a;[18:31:47]  [INFO] IO状态更新&#x0a;[18:32:10]  [INFO] 状态监测运行中"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="#CBD5E1"
                                 FontSize="11"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="⚙" FontSize="20" Foreground="#CBD5E1" Margin="6,0,22,0"/>
                            <TextBlock Text="ⓘ" FontSize="20" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== 主内容区 ===================== -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.05*"/>
                <RowDefinition Height="0.95*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="1.55*"/>
            </Grid.ColumnDefinitions>

            <!-- =====================================================
                 1. 机器人基础状态
                 ===================================================== -->
            <Border Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="1. 机器人基础状态"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Foreground="#8A98AA"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="机器人模式" Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtRobotMode" Text="未知" Style="{StaticResource ValueTextStyle}"/>
                                    <Ellipse x:Name="EllipseRobotModeDot" Style="{StaticResource StatusDotGreen}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="运行模式" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtOperationalModeValue"
                                           Text="未知"
                                           Style="{StaticResource ValueTextStyle}"
                                           Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="安全状态" Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtEmergencyState" Text="未知" Style="{StaticResource ValueTextStyle}"/>
                                    <Ellipse x:Name="EllipseSafetyDot" Style="{StaticResource StatusDotGreen}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="程序状态" Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtProgramState" Text="未知" Style="{StaticResource ValueTextStyle}"/>
                                    <Ellipse x:Name="EllipseProgramDot" Style="{StaticResource StatusDotGreen}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource InnerBoxStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="当前程序"
                                           Grid.Row="0"
                                           Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock x:Name="TxtLoadedProgramValue"
                                           Grid.Row="1"
                                           Text="--"
                                           Style="{StaticResource ValueTextStyle}"
                                           Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           TextTrimming="None"
                                           VerticalAlignment="Top"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="远程控制" Style="{StaticResource LabelTextStyle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock x:Name="TxtRemoteControlValue" Text="未知" Style="{StaticResource ValueTextStyle}"/>
                                    <Ellipse x:Name="EllipseRemoteDot" Style="{StaticResource StatusDotGreen}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="机器人型号" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtRobotModelValue" Text="未知" Style="{StaticResource ValueTextStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="序列号" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtSerialNumberValue" Text="未知" Style="{StaticResource ValueTextStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="PolyScope版本" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtPolyScopeVersionValue" Text="未知" Style="{StaticResource ValueTextStyle}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- =====================================================
                 2. 实时运动状态
                 ===================================================== -->
            <Border Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="2. 实时运动状态"
                                   Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗"
                                   DockPanel.Dock="Right"
                                   HorizontalAlignment="Right"
                                   Foreground="#8A98AA"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Style="{StaticResource InnerBoxStyle}"
                                Padding="0">
                            <DataGrid x:Name="DgRtdeJointState"
                                      AutoGenerateColumns="False"
                                      HeadersVisibility="Column"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      GridLinesVisibility="Horizontal"
                                      RowHeaderWidth="0"
                                      FontSize="11"
                                      BorderThickness="0"
                                      Background="Transparent">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="关节" Binding="{Binding Joint}" Width="42"/>
                                    <DataGridTextColumn Header="实际角度(°)" Binding="{Binding ActualDeg}" Width="*"/>
                                    <DataGridTextColumn Header="速度(rad/s)" Binding="{Binding SpeedRad}" Width="*"/>
                                    <DataGridTextColumn Header="电流(A)" Binding="{Binding CurrentA}" Width="*"/>
                                    <DataGridTextColumn Header="温度(℃)" Binding="{Binding TemperatureC}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- TCP 状态 -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="TCP状态" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <UniformGrid Columns="3" Rows="2">
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP X(mm)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentX" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP Y(mm)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentY" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP Z(mm)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentZ" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP Rx(rad)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentRx" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP Ry(rad)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentRy" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                        <StackPanel Margin="2">
                                            <TextBlock Text="TCP Rz(rad)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="TxtCurrentRz" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="TCP线速度(mm/s)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTcpSpeed" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="TCP线加速度(mm/s²)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtTcpAcceleration" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <UniformGrid Columns="2">
                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="TCP力(N)" FontWeight="SemiBold" FontSize="12"/>
                                        <UniformGrid Columns="3" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Fx" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpFx" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Fy" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpFy" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Fz" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpFz" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="TCP力矩(Nm)" FontWeight="SemiBold" FontSize="12"/>
                                        <UniformGrid Columns="3" Margin="0,8,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Mx" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpMx" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="My" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpMy" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Mz" HorizontalAlignment="Center" FontSize="11"/>
                                                <TextBlock x:Name="TxtTcpMz" Text="--" HorizontalAlignment="Center" FontSize="11"/>
                                            </StackPanel>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- =====================================================
                 3. 运动参数设置
                 ===================================================== -->
            <Border Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="44"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="3. 运动参数设置" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8A98AA"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- 左列：MoveJ / MoveL 参数。Label 在上，TextBox 在下，避免遮挡。 -->
                        <UniformGrid Grid.Column="0"
                                     Columns="2"
                                     Rows="3"
                                     Margin="0,0,8,0">

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveJ 速度 v(rad/s)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveJVelocity"
                                             Text="0.30"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveJ 加速度 a(rad/s²)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveJAcceleration"
                                             Text="0.50"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveJ 时间 t(s)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveJTime"
                                             Text="0.00"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveJ Blend 半径 r(m)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveJBlendRadius"
                                             Text="0.00"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveL 速度 v(m/s)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveLVelocity"
                                             Text="0.25"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="MoveL 加速度 a(m/s²)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtMoveLAcceleration"
                                             Text="1.20"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- 右列：Servo / 到位判断参数。Label 在上，TextBox 在下，避免长英文遮挡。 -->
                        <UniformGrid Grid.Column="1"
                                     Columns="2"
                                     Rows="4">

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="SpeedJ 持续时间 t(s)"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtSpeedJDuration"
                                             Text="0.50"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="ServoJ lookahead_time"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtServoJLookahead"
                                             Text="0.10"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="ServoJ gain"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtServoJGain"
                                             Text="300"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="到位误差 toleranceDeg"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToleranceDeg"
                                             Text="0.50"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="超时时间 timeoutMsPerPoint"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtTimeoutMsPerPoint"
                                             Text="20000"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="轮询间隔 pollIntervalMs"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPollIntervalMs"
                                             Text="20"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="稳定次数 stableCount"
                                               Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtStableCount"
                                             Text="3"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>

                    <UniformGrid Grid.Row="2" Columns="3" Margin="0,8,0,0">
                        <Button x:Name="BtnApplyRobotParams" Content="✓ 应用参数" Style="{StaticResource PrimaryButtonStyle}" Margin="4,0"/>
                        <Button x:Name="BtnRestoreRobotParams" Content="⟳ 恢复默认" Style="{StaticResource OutlineButtonStyle}" Margin="4,0"/>
                        <Button x:Name="BtnSaveRobotParams" Content="▣ 保存配置" Style="{StaticResource OutlineButtonStyle}" Margin="4,0"/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- =====================================================
                 4. 工具 / RCM 设置
                 ===================================================== -->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="4. 工具 / RCM 设置" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8A98AA"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="1.05*"/>
                            <ColumnDefinition Width="0.9*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Tool 参数 -->
                        <UniformGrid Grid.Column="0"
                                     Columns="2"
                                     Rows="3"
                                     Margin="0,0,8,0">

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_X (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolX"
                                             Text="0.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_Y (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolY"
                                             Text="0.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_Z (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolZ"
                                             Text="150.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_Rx (rad)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolRx"
                                             Text="0.000"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_Ry (rad)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolRy"
                                             Text="0.000"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool_Rz (rad)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtToolRz"
                                             Text="0.000"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- RCM 参数 -->
                        <Grid Grid.Column="1" Margin="0,0,8,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="38"/>
                                <RowDefinition Height="24"/>
                            </Grid.RowDefinitions>

                            <UniformGrid Grid.Row="0"
                                         Columns="1"
                                         Rows="3">
                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="RCM_X (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRcmX"
                                                 Text="500.0"
                                                 Style="{StaticResource CompactParamTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="RCM_Y (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRcmY"
                                                 Text="0.0"
                                                 Style="{StaticResource CompactParamTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource InnerBoxStyle}">
                                    <StackPanel>
                                        <TextBlock Text="RCM_Z (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                        <TextBox x:Name="TxtRcmZ"
                                                 Text="250.0"
                                                 Style="{StaticResource CompactParamTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <CheckBox x:Name="ChkRcmMode"
                                      Grid.Row="1"
                                      Content="启用 RCM"
                                      IsChecked="True"
                                      FontSize="12"
                                      VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Text="ⓘ 用于七轴逆解 / 路径规划"
                                       Foreground="#667085"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Payload 参数 -->
                        <UniformGrid Grid.Column="2"
                                     Columns="1"
                                     Rows="4">
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Payload Mass (kg)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPayloadMass"
                                             Text="2.000"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="CoG X (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPayloadCogX"
                                             Text="0.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="CoG Y (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPayloadCogY"
                                             Text="0.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="CoG Z (mm)" Style="{StaticResource ParamFieldLabelStyle}"/>
                                    <TextBox x:Name="TxtPayloadCogZ"
                                             Text="50.0"
                                             Style="{StaticResource CompactParamTextBoxStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- =====================================================
                 5. IO / 工具状态
                 ===================================================== -->
            <Border Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <TextBlock Text="5. IO / 工具状态" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8A98AA"/>
                    </DockPanel>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <Border Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="数字输入 (DI)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushPrimary}"/>
                                <UniformGrid Columns="8" Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI0" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI0" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI1" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI1" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI2" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI2" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI3" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI3" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI4" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI4" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI5" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI5" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI6" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI6" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DI7" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDI7" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource InnerBoxStyle}">
                            <StackPanel>
                                <TextBlock Text="数字输出 (DO)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushPrimary}"/>
                                <UniformGrid Columns="8" Margin="0,8,0,0">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO0" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO0" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO1" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO1" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO2" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO2" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO3" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO3" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO4" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO4" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO5" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO5" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO6" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO6" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="DO7" FontSize="11" HorizontalAlignment="Center"/>
                                        <Ellipse x:Name="EllipseDO7" Style="{StaticResource IoDotOff}"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <UniformGrid Columns="4">
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="AI0(V)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAI0" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="AI1(V)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAI1" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="AO0(V)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAO0" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="AO1(V)" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtAO1" Text="--" Style="{StaticResource SmallValueTextStyle}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <UniformGrid Columns="3">
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool Voltage" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtToolVoltageValue" Text="-- V" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMain}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool Current" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtToolCurrentValue" Text="-- A" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMain}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource InnerBoxStyle}">
                                <StackPanel>
                                    <TextBlock Text="Tool Temperature" Style="{StaticResource LabelTextStyle}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtToolTemperatureValue" Text="-- ℃" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource BrushTextMain}"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =====================================================
                 6. 通信状态
                 ===================================================== -->
            <Border Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock Text="6. 通信状态" Style="{StaticResource CardTitleStyle}"/>
                        <TextBlock Text="↗" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#8A98AA"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.2*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource InnerBoxStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                    <RowDefinition Height="34"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="网络延迟" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtNetworkDelay" Grid.Row="0" Grid.Column="1" Text="--" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="丢包率" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtPacketLoss" Grid.Row="1" Grid.Column="1" Text="--" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="RTDE频率" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtControlFrequency" Grid.Row="2" Grid.Column="1" Text="--" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="控制周期" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtStatusControlPeriod" Grid.Row="3" Grid.Column="1" Text="--" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="最后接收时间" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtLastRtdeReceiveTime" Grid.Row="4" Grid.Column="1" Text="--" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Dashboard刷新" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtDashboardRefresh" Grid.Row="5" Grid.Column="1" Text="500 ms" Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource InnerBoxStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="44"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="通信质量（延迟 ms）"
                                           Style="{StaticResource LabelTextStyle}"
                                           FontWeight="SemiBold"/>

                                <!-- 延迟波形图区域 -->
                                <Grid x:Name="GridNetworkChart"
                                      Grid.Row="1"
                                      Margin="0,4,0,0"
                                      ClipToBounds="True">
                                    <Border BorderBrush="#E3E8F0"
                                            BorderThickness="1"
                                            Background="#FFFFFF"/>

                                    <Polyline x:Name="PolylineNetworkDelay"
                                              Stroke="{StaticResource BrushPrimary}"
                                              StrokeThickness="2"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              Stretch="None"
                                              Margin="8"/>
                                </Grid>

                                <DockPanel Grid.Row="2" Margin="0,8,0,0">
                                    <TextBlock Text="信号质量"
                                               Style="{StaticResource LabelTextStyle}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel DockPanel.Dock="Right"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom">
                                        <Rectangle x:Name="RectSignal1"
                                                   Width="10"
                                                   Height="14"
                                                   Fill="{StaticResource BrushSuccess}"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Margin="3,0"/>

                                        <Rectangle x:Name="RectSignal2"
                                                   Width="10"
                                                   Height="20"
                                                   Fill="{StaticResource BrushSuccess}"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Margin="3,0"/>

                                        <Rectangle x:Name="RectSignal3"
                                                   Width="10"
                                                   Height="26"
                                                   Fill="{StaticResource BrushSuccess}"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Margin="3,0"/>

                                        <Rectangle x:Name="RectSignal4"
                                                   Width="10"
                                                   Height="32"
                                                   Fill="{StaticResource BrushSuccess}"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Margin="3,0"/>

                                        <Rectangle x:Name="RectSignal5"
                                                   Width="10"
                                                   Height="38"
                                                   Fill="{StaticResource BrushSuccess}"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Margin="3,0"/>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== 底部状态栏 ===================== -->
        <Border Grid.Row="2"
                Grid.Column="1"
                Background="#000000"
                BorderBrush="#D8E0EA"
                BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0"/>
                    <TextBlock Text="系统运行正常" Style="{StaticResource ValueTextStyle}" Foreground="White"/>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="TxtSystemTime"
                           Text="本地时间：2026-05-16 18:32:15"
                           Style="{StaticResource ValueTextStyle}"
                           Margin="0,0,32,0"
                           Foreground="White"/>
                <TextBlock Grid.Column="2"
                           Text="👤 用户：Shixing Ma"
                           Style="{StaticResource ValueTextStyle}"
                           Foreground="White"/>
            </Grid>
        </Border>
    </Grid>
</Window>
