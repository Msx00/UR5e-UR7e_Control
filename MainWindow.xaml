                                <TextBox x:Name="TxtTcpX" Grid.Row="0" Grid.Column="1" Text="450.00"/>

                                <TextBlock Text="Rx (°)" Grid.Row="0" Grid.Column="2" Style="{StaticResource LabelTextStyle}" Margin="12,0,0,0"/>
