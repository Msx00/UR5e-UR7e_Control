<Window x:Class="WpfRobot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="version 2.1"
        Width="1600"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="#000000"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- =========================================================
             现代医疗机器人控制台主题
             说明：
             1) 不改任何 x:Name 和 Click 事件；
             2) 只增强字体、颜色、圆角、阴影、按钮、输入框、表格和日志区；
             3) 可直接整体替换 MainWindow.xaml。
             ========================================================= -->

        <!-- 颜色 -->
        <Color x:Key="PrimaryColor">#2563EB</Color>
        <Color x:Key="PrimaryHoverColor">#1D4ED8</Color>
        <Color x:Key="PrimarySoftColor">#DBEAFE</Color>

        <!--<Color x:Key="AppBackgroundColor">#EEF3F8</Color>-->
        <Color x:Key="AppBackgroundColor">#000000</Color>
        <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
        <Color x:Key="PanelBackgroundColor">#F8FAFC</Color>
        <Color x:Key="TopBarColor">#0F172A</Color>

        <Color x:Key="BorderLightColor">#D8E0EA</Color>
        <Color x:Key="BorderFocusColor">#60A5FA</Color>

        <Color x:Key="TextMainColor">#111827</Color>
        <Color x:Key="TextSubColor">#64748B</Color>

        <Color x:Key="SuccessColor">#16A34A</Color>
        <Color x:Key="DangerColor">#DC2626</Color>
        <Color x:Key="WarningColor">#F59E0B</Color>

        <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}"/>
        <SolidColorBrush x:Key="PrimarySoftBrush" Color="{StaticResource PrimarySoftColor}"/>

        <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}"/>
        <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}"/>
        <SolidColorBrush x:Key="TopBarBrush" Color="{StaticResource TopBarColor}"/>

        <SolidColorBrush x:Key="BorderBrushLight" Color="{StaticResource BorderLightColor}"/>
        <SolidColorBrush x:Key="BorderFocusBrush" Color="{StaticResource BorderFocusColor}"/>

        <SolidColorBrush x:Key="TextMainBrush" Color="{StaticResource TextMainColor}"/>
        <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSubColor}"/>

        <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>

        <!-- 卡片样式：圆角 + 柔和阴影 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushLight}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="10,7"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000"
                                      BlurRadius="14"
                                      ShadowDepth="2"
                                      Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题文字 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>

        <!-- 普通标签 -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <!-- 基础按钮模板 -->
        <Style x:Key="BaseButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinWidth" Value="78"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 普通小按钮 -->
        <Style x:Key="ToolButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="Foreground" Value="#111827"/>
        </Style>

        <!-- 主按钮 -->
        <Style x:Key="PrimaryButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- 危险按钮：停止、断开 -->
        <Style x:Key="DangerButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="#FEF2F2"/>
            <Setter Property="BorderBrush" Value="#FCA5A5"/>
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        </Style>

        <!-- 当前选中的 Tab -->
        <Style x:Key="ActiveTabButtonStyle"
               TargetType="{x:Type Button}"
               BasedOn="{StaticResource BaseButtonStyle}">
            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
            <Setter Property="BorderBrush" Value="#93C5FD"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- 输入框 -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderFocusBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- 复选框 -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 滑块 -->
        <Style TargetType="{x:Type Slider}">
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="6,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 表格 -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5EAF1"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5EAF1"/>
            <Setter Property="BorderBrush" Value="#D8E0EA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFC"/>
            <Setter Property="RowHeight" Value="31"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>

            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="Background" Value="#F1F5F9"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="#D8E0EA"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </Setter.Value>
            </Setter>

            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="{x:Type DataGridCell}">
                        <Setter Property="Padding" Value="6,0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMainBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="87*"/>
            <ColumnDefinition Width="1513*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0"
                Background="{StaticResource TopBarBrush}"
                BorderBrush="#1E293B"
                BorderThickness="0,0,0,1" Grid.ColumnSpan="2">
            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Left"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="12,0,0,0">

                    <Image x:Name="ImgSduLogo"
                           Source="pack://siteoforigin:,,,/icon/sdu.png"
                           Width="45"
                           Height="45"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>
                    <!--<Image x:Name="ImgQiluLogo"
                           Source="pack://siteoforigin:,,,/icon/qilu.png"
                           Width="45"
                           Height="45"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>-->

                    <!--<Image Source="pack://siteoforigin:,,,/icon/robotics_research_center.png"
                           Height="45"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>-->

                    <!--<TextBlock Text="??"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="机械臂控制与导航系统"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#111827"/>-->

                    <!--<TextBlock Text="SX"
                               FontSize="13"
                               Margin="10,4,20,0"
                               VerticalAlignment="Center"
                               Foreground="#374151"/>-->

                    <Button x:Name="BtnConnect"
                            Content="连接"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnConnect_Click"/>

                    <Button x:Name="BtnDisconnect"
                            Content="断开"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnDisconnect_Click"/>

                    <Separator Width="18" Background="Transparent"/>

                    <Button x:Name="BtnInitialize"
                            Content="初始化"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnInitialize_Click"/>

                    <Button x:Name="BtnZero"
                            Content="回零"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnZero_Click"/>

                    <Button x:Name="BtnHome"
                            Content="回零点"
                            Style="{StaticResource ToolButtonStyle}"
                            Click="BtnHome_Click"/>


                    <Button x:Name="BtnStop"
                            Content="■ 停止"
                            Style="{StaticResource DangerButtonStyle}"
                            Click="BtnStop_Click"/>

                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0">

                    <Ellipse Width="10" Height="10" Fill="#22A447" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtConnectionState"
                               Text="已连接"
                               Foreground="#22A447"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <Button x:Name="BtnMore"
                            Content="更多"
                            Style="{StaticResource ToolButtonStyle}"/>
                </StackPanel>

            </DockPanel>
        </Border>

        <!-- 主体区域 -->
        <Grid Grid.Row="1" Grid.ColumnSpan="2" Background="#000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧控制区域 -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- 连接设置 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="连接设置"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="IP地址"
                                           Style="{StaticResource LabelTextStyle}"/>
                                <ComboBox x:Name="TxtRobotIp"
                                          Grid.Column="1"
                                          IsEditable="True"
                                          SelectedIndex="0"
                                          Text="192.168.3.200">
                                    <ComboBoxItem Content="192.168.239.128"/>
                                    <ComboBoxItem Content="192.168.3.200"/>
                                    <ComboBoxItem Content="192.168.159.128"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="35*"/>
                                    <ColumnDefinition Width="24*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="端口"
                                           Style="{StaticResource LabelTextStyle}"/>
                                <TextBox x:Name="TxtRobotPort"
                                         Grid.Column="1"
                                         Text="30001" Grid.ColumnSpan="2"/>
                            </Grid>

                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="BtnLeftConnect"
                                        Content="连接"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="BtnConnect_Click" Height="NaN" Margin="0,8,0,0"/>

                                <Button x:Name="BtnLeftDisconnect"
                                        Grid.Column="1"
                                        Content="断开"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Height="34"
                                        Margin="12,6,0,0"
                                        Click="BtnDisconnect_Click" Grid.ColumnSpan="2" VerticalAlignment="Top"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock Text="机器人通信状态："
                                           Style="{StaticResource LabelTextStyle}"/>
                                <Ellipse Width="9" Height="9" Fill="#22A447" Margin="8,0,5,0"/>
                                <TextBlock x:Name="TxtRobotCommState"
                                           Text="已连接"
                                           Foreground="#22A447"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- 正运动学控制 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="正运动学控制（关节角度）"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <!-- J1 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J1 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ1"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ1"
                                         Grid.Column="2"
                                         Text="90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <!-- J2 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J2 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ2"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="-90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ2"
                                         Grid.Column="2"
                                         Text="-90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <!-- J3 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J3 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ3"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ3"
                                         Grid.Column="2"
                                         Text="90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <!-- J4 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J4 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ4"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="-90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ4"
                                         Grid.Column="2"
                                         Text="-90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <!-- J5 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J5 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ5"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="-90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ5"
                                         Grid.Column="2"
                                         Text="-90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <!-- J6 -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="75"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="J6 (°)" Style="{StaticResource LabelTextStyle}"/>
                                <Slider x:Name="SliderJ6"
                                        Grid.Column="1"
                                        Minimum="-360"
                                        Maximum="360"
                                        Value="90"
                                        TickFrequency="1"
                                        IsSnapToTickEnabled="False"
                                        ValueChanged="JointSlider_ValueChanged"/>
                                <TextBox x:Name="TxtJ6"
                                         Grid.Column="2"
                                         Text="90.00"
                                         LostFocus="JointTextBox_LostFocus"/>
                            </Grid>

                            <Button x:Name="BtnSendJointCommand"
                                    Content="发送关节指令"
                                    ToolTip="拖动滑条只改变仿真,点击此按钮才会驱动机器人运动"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnSendJointCommand_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- 逆运动学控制 -->
                    <!--
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="逆运动学控制（TCP位姿）"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
