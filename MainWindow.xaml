                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                    <RowDefinition Height="28"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="模式：" Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtRobotMode" Text="自动" Grid.Row="0" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock Text="使能状态：" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtEnableState" Text="● 已使能" Grid.Row="1" Grid.Column="1" Foreground="#22A447" VerticalAlignment="Center"/>

                                <TextBlock Text="急停状态：" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtEmergencyState" Text="● 正常" Grid.Row="2" Grid.Column="1" Foreground="#22A447" VerticalAlignment="Center"/>

                                <TextBlock Text="运行状态：" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtRunState" Text="● 空闲" Grid.Row="3" Grid.Column="1" Foreground="#22A447" VerticalAlignment="Center"/>

                                <TextBlock Text="程序状态：" Grid.Row="4" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtProgramState" Text="无程序运行" Grid.Row="4" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock Text="TCP速度：" Grid.Row="5" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtTcpSpeed" Text="0.0 mm/s" Grid.Row="5" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock Text="TCP加速度：" Grid.Row="6" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtTcpAcceleration" Text="0.0 mm/s2" Grid.Row="6" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock Text="控制频率：" Grid.Row="7" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtControlFrequency" Text="125 Hz" Grid.Row="7" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>

                                <TextBlock Text="系统时间：" Grid.Row="8" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBlock x:Name="TxtSystemTime" Text="2025-05-20 14:35:27" Grid.Row="8" Grid.Column="1" Style="{StaticResource LabelTextStyle}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- 当前关节角 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="当前关节角（°）"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <DataGrid x:Name="DgJointState" Height="205">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="关节" Binding="{Binding Joint}" Width="*"/>
                                    <DataGridTextColumn Header="当前值" Binding="{Binding Current}" Width="*"/>
                                    <DataGridTextColumn Header="目标值" Binding="{Binding Target}" Width="*"/>
                                    <DataGridTextColumn Header="偏差" Binding="{Binding Error}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- 末端位姿 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="当前末端位姿（六关节基坐标系）"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                    <RowDefinition Height="32"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="位置（mm）" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="姿态（°）" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                                <TextBlock Text="X" Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox x:Name="TxtCurrentX" Grid.Row="1" Grid.Column="1" Text="450.00"/>

                                <TextBlock Text="Rx" Grid.Row="1" Grid.Column="2" Style="{StaticResource LabelTextStyle}" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtCurrentRx" Grid.Row="1" Grid.Column="3" Text="0.00"/>

                                <TextBlock Text="Y" Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox x:Name="TxtCurrentY" Grid.Row="2" Grid.Column="1" Text="200.00"/>

                                <TextBlock Text="Ry" Grid.Row="2" Grid.Column="2" Style="{StaticResource LabelTextStyle}" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtCurrentRy" Grid.Row="2" Grid.Column="3" Text="90.00"/>

                                <TextBlock Text="Z" Grid.Row="3" Grid.Column="0" Style="{StaticResource LabelTextStyle}"/>
                                <TextBox x:Name="TxtCurrentZ" Grid.Row="3" Grid.Column="1" Text="350.00"/>

                                <TextBlock Text="Rz" Grid.Row="3" Grid.Column="2" Style="{StaticResource LabelTextStyle}" Margin="8,0,0,0"/>
                                <TextBox x:Name="TxtCurrentRz" Grid.Row="3" Grid.Column="3" Text="0.00"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- AI控制入口 -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel>
                            <TextBlock Text="AI自动控制入口"
                                       Style="{StaticResource CardTitleStyle}"/>

                            <CheckBox x:Name="ChkEnableAIControl"
                                      Content="启用AI自动控制"
                                      Margin="0,4"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="控制模式" Style="{StaticResource LabelTextStyle}"/>
                                <ComboBox x:Name="CmbAIControlMode" Grid.Column="1" SelectedIndex="0">
                                    <ComboBoxItem Content="下一状态关节角控制"/>
                                    <ComboBoxItem Content="TCP目标控制"/>
                                    <ComboBoxItem Content="RCM约束控制"/>
                                </ComboBox>
                            </Grid>

                            <!--<Button x:Name="BtnOpenAIControlPage"
                                    Content="打开AI控制页面"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Click="BtnOpenAIControlPage_Click"/>-->
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 底部状态栏 -->
        <Border Grid.Row="2"
        Grid.ColumnSpan="2"
        Height="30"
        Background="#000000"
        BorderBrush="#000000"
        BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    Margin="12,0"
                    VerticalAlignment="Center">
                    <Ellipse Width="10"
                     Height="10"
                     Fill="#2F80ED"
                     VerticalAlignment="Center"/>
                    <TextBlock Text="就绪"
                       Margin="8,0"
                       VerticalAlignment="Center"
                       Foreground="White"/>
                </StackPanel>

                <TextBlock Grid.Column="2"
                   x:Name="TxtStatusControlPeriod"
                   Text="控制周期：8.0 ms"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="White"/>

                <TextBlock Grid.Column="3"
                   x:Name="TxtNetworkDelay"
                   Text="网络延迟：2.1 ms"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="White"/>

                <TextBlock Grid.Column="4"
                   x:Name="TxtPacketLoss"
                   Text="丢包率：0.0 %"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Foreground="White"/>
            </Grid>
        </Border>

    </Grid>
</Window>