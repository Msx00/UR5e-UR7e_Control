    <sys:String x:Key="Label_TcpSpeed">TCP速度</sys:String>
    <sys:String x:Key="Label_TcpAcceleration">TCP加速度</sys:String>

    <sys:String x:Key="Msg_ToolParamError">工具参数输入格式错误，请检查 Tool_X / Tool_Y / Tool_Z 是否都是有效数字。</sys:String>
    <sys:String x:Key="Title_ToolParamError">工具参数错误</sys:String>

