<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:String x:Key="App_Title">机器人控制系统</sys:String>

    <sys:String x:Key="Lang_Chinese">中文</sys:String>
    <sys:String x:Key="Lang_English">English</sys:String>
    <sys:String x:Key="Lang_Select">语言</sys:String>

    <sys:String x:Key="Tab_MasterControl">主从控制</sys:String>
    <sys:String x:Key="Tab_Simulation">仿真</sys:String>
    <sys:String x:Key="Tab_Status">状态监测</sys:String>
    <sys:String x:Key="Tab_Calibration">标定</sys:String>
    <sys:String x:Key="Tab_Trajectory">轨迹规划</sys:String>
    <sys:String x:Key="Tab_AIControl">AI自动控制</sys:String>

    <sys:String x:Key="Btn_Connect">连接</sys:String>
    <sys:String x:Key="Btn_Disconnect">断开</sys:String>
    <sys:String x:Key="Btn_Initialize">初始化</sys:String>
    <sys:String x:Key="Btn_Zero">回零</sys:String>
